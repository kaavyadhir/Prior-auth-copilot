# ---------------------------------------------------------------------------
# TEMPLATE ONLY - this file IS committed to git. Never put a real key here.
# Copy it to .env (which is gitignored) and put your real values there:
#     copy .env.example .env
# ---------------------------------------------------------------------------

# Create one at https://aistudio.google.com/apikey  ("Create API key").
# Current keys begin with "AQ." ; older ones begin with "AIza". Both work.
GEMINI_API_KEY=your_key_here

# Model used for criteria extraction + evaluation.
# Run `python scripts/list_models.py` to see what your key can access.
# Note: a model appearing in list_models is not proof your key can call it -
# retired models are still advertised. scripts/check_llm.py tests an actual call.
LLM_MODEL=gemini-3.8-flash

# Tried in order when the primary is overloaded (503) or retired (404).
LLM_FALLBACK_MODELS=gemini-flash-latest,gemini-3-flash-preview
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_SECONDS=1.0

# Embedding model used for policy retrieval (Gemini API).
EMBEDDING_MODEL=gemini-embedding-001
# Left empty on purpose - see the comment in app/config.py.
EMBEDDING_FALLBACK_MODELS=
EMBEDDING_DIMENSIONS=768

# Decision thresholds (see README - Decision Policy)
MIN_RETRIEVAL_SIMILARITY=0.35
TOP_K=5
